# Every variable the application reads, including the ones with defaults.
# Copy to .env and fill in. Never commit .env.
#
# A variable added to the code is added here in the same commit. This file is
# the only machine-checkable record of what a deployment needs.

# --- Database -------------------------------------------------------------
# The database's password, for docker compose. Required: compose refuses to
# start without it rather than falling back to a password everybody knows.
# Make one with:  openssl rand -base64 24
#
# A development database created before this was required was made with the
# old default; set POSTGRES_PASSWORD=freesms to keep using it.
POSTGRES_PASSWORD=

# Running the binary outside compose, it reads this instead. The database name
# is read from here and never repeated in a script.
DATABASE_URL=postgres://freesms:change-me@localhost:5432/freesms?sslmode=disable

# --- HTTP -----------------------------------------------------------------
# Address the server binds to inside the container.
HTTP_ADDR=:8080

# Where compose publishes it on the host: loopback unless you say otherwise.
# Put a reverse proxy with HTTPS in front to reach it from the network (see
# DEPLOY.md); 0.0.0.0 publishes plain HTTP to every network the host is on.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Public URL, including scheme. Used for links sent to customers, and for
# cookie and CSRF configuration. Getting this wrong breaks approval links in a
# way that is not visible from inside the shop.
BASE_URL=http://localhost:8080

# --- Security -------------------------------------------------------------
# There is no session secret. A session is a random token whose hash is kept
# in the database, and no key is involved in checking one. To sign everybody
# out -- a lost tablet, a leaked cookie -- run, beside the service:
#
#   docker compose exec app /freesms -revoke-sessions
#
# An older .env that still sets SESSION_SECRET starts normally and says so.

# --- Storage --------------------------------------------------------------
# Where inspection photos are written. Must be on persistent storage and must
# be included in backups; this is the one thing in the system that cannot be
# regenerated from the database.
ATTACHMENTS_DIR=/var/lib/freesms/attachments

# Where the owner's export of the whole shop is written: every customer, job,
# invoice and photograph, as CSV and JPEG. Choose somewhere only the service
# can read; files are written readable by the service's user alone.
EXPORT_DIR=/var/lib/freesms/exports

# --- Localisation ---------------------------------------------------------
# The language the workshop is created in at setup, and the setup page's own.
# After that the workshop's language is changed under /shop, and each person
# can choose their own under /account. en or sv; anything else is English.
DEFAULT_LOCALE=en

# --- Tenancy -------------------------------------------------------------
# Which shop this installation serves. Leave empty for the normal case of one
# workshop running its own copy: the single shop in the database is used, and
# startup fails if there is none or more than one rather than guessing.
SHOP_ID=

# --- Vehicle lookup ------------------------------------------------------
# Optional. Where to look a registration up, with {registration} where the
# plate goes. No provider ships with this project: Swedish vehicle data comes
# from Transportstyrelsen under an agreement that is the shop's to hold, not
# the software's.
#
# Leave empty and the intake form simply does not offer a lookup. It never
# blocks taking a car in either way.
VEHICLE_LOOKUP_URL=
VEHICLE_LOOKUP_TOKEN=

# --- Operations -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# Set by the deploy to the commit SHA. Reported by /healthz and attached to
# errors, so a report can be tied to a known build.
RELEASE=dev
