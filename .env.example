# Every variable the application reads, including the ones with defaults.
# Copy to .env and fill in. Never commit .env.
#
# A variable added to the code is added here in the same commit. This file is
# the only machine-checkable record of what a deployment needs.

# --- Database -------------------------------------------------------------
# The database name is read from here and never repeated in a script.
DATABASE_URL=postgres://freesms:change-me@localhost:5432/freesms?sslmode=disable

# --- HTTP -----------------------------------------------------------------
# Address the server binds to inside the container.
HTTP_ADDR=:8080

# Public URL, including scheme. Used for links sent to customers, and for
# cookie and CSRF configuration. Getting this wrong breaks approval links in a
# way that is not visible from inside the shop.
BASE_URL=http://localhost:8080

# --- Security -------------------------------------------------------------
# 32+ random bytes, base64. Rotating it logs everyone out.
# Generate: openssl rand -base64 32
SESSION_SECRET=change-me-this-is-not-a-real-secret

# --- Storage --------------------------------------------------------------
# Where inspection photos are written. Must be on persistent storage and must
# be included in backups; this is the one thing in the system that cannot be
# regenerated from the database.
ATTACHMENTS_DIR=/var/lib/freesms/attachments

# --- Localisation ---------------------------------------------------------
# Fallback when a user and their shop have no preference. Always a locale that
# has a complete catalogue.
DEFAULT_LOCALE=en

# --- Tenancy -------------------------------------------------------------
# Which shop this installation serves. Leave empty for the normal case of one
# workshop running its own copy: the single shop in the database is used, and
# startup fails if there is none or more than one rather than guessing.
SHOP_ID=

# --- Vehicle lookup ------------------------------------------------------
# Optional. Where to look a registration up, with {registration} where the
# plate goes. No provider ships with this project: Swedish vehicle data comes
# from Transportstyrelsen under an agreement that is the shop's to hold, not
# the software's.
#
# Leave empty and the intake form simply does not offer a lookup. It never
# blocks taking a car in either way.
VEHICLE_LOOKUP_URL=
VEHICLE_LOOKUP_TOKEN=

# --- Operations -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# Set by the deploy to the commit SHA. Reported by /healthz and attached to
# errors, so a report can be tied to a known build.
RELEASE=dev
